# ── Service ──────────────────────────────────────────────────────────────────
ENV=development
AI_AGENTS_API_KEY=internal-secret

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...           # optional — enables LLM fallback
LLM_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-4-6

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_compliance
REDIS_URL=redis://localhost:6379

# ── Vector Store ──────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                  # leave empty for local Qdrant

# ── Email Providers (at least one required for SendingAgent) ─────────────────
SENDGRID_API_KEY=SG....          # primary
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_REGION=us-east-1
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── Global SMTP (one account for all products; takes priority when set) ──────
# Gmail: enable 2-Step Verification, then create an App Password (16 chars).
# SMTP_FROM must equal SMTP_USER (or a verified "Send mail as" alias) for Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=                   # 16-char Gmail App Password
SMTP_FROM=your-account@gmail.com
SMTP_FROM_NAME=BridgingTech
SMTP_STARTTLS=true               # true for port 587; false + port 465 for implicit TLS

# ── Kafka (opt-in — set to true to enable event streaming) ───────────────────
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=email-sentinel

# ── Observability (optional) ─────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
