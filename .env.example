# ─── Database ───────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_compliance"
REDIS_URL="redis://localhost:6379"

# ─── API ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# ─── AI / LLM ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...          # fallback
LLM_PROVIDER=anthropic         # anthropic | openai
DEFAULT_MODEL=claude-opus-4-8

# ─── Vector Store (Qdrant) ──────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Object Storage ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=bridgingtech-email-attachments

# ─── Email Sending OAuth ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── KMS / Encryption ───────────────────────────────────────────
ENCRYPTION_KEY=change-me-32-bytes-hex-key-here!!

# ─── Slack (approval notifications) ────────────────────────────
SLACK_WEBHOOK_URL=

# ─── AI Agents service ──────────────────────────────────────────
AI_AGENTS_URL=http://localhost:8000
AI_AGENTS_API_KEY=internal-secret

# ─── Web ────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME="AI Compliance Sentinel"
